__pycache__/
*.py[cod]
*.egg-info/
.venv/
wandb/
runs_*/
/outputs/
/cache/
/data/
*.pt
*.pth
*.safetensors
*.pdparams
.DS_Store

# Configs are tracked; everything else that looks like a weight is not.
!train/config/*/*.yaml

# Weights and datasets are release assets, not tracked files.
weights/*
!weights/README.md
!weights/checksums.txt

# Fonts are tracked — see font/README.md for their provenance.

# Synthetic-generation assets (9.1 GB of backgrounds, 654 MB of fonts).
synth/*/datasets/

# SynthText corpus leftovers the plate generators never read. Only
# plate_list_final2.txt, ccpd_plate_list.txt and colors_new.cp are used.
synth/*/Synthtext/data/*
!synth/*/Synthtext/data/plate_list_final2.txt
!synth/*/Synthtext/data/ccpd_plate_list.txt
!synth/*/Synthtext/data/colors_new.cp
